# Copy to .env. These values work with docker-compose.yml without changes.
APP_ENV=dev
LOG_LEVEL=INFO

# Postgres. The admin URL is used only by scripts/migrate.py and by the eval ground-truth queries.
DATABASE_ADMIN_URL=postgresql://copilot:copilot@localhost:5433/copilot
DATABASE_URL=postgresql://copilot_app:copilot_app@localhost:5433/copilot
DATABASE_RO_URL=postgresql://copilot_readonly:copilot_readonly@localhost:5433/copilot
APP_DB_PASSWORD=copilot_app
RO_DB_PASSWORD=copilot_readonly

# LLM provider: groq | openai | fake
LLM_PROVIDER=groq
GROQ_API_KEY=
OPENAI_API_KEY=
# Check current ids at console.groq.com/docs/models; run scripts/llm_smoke.py after changing them.
MODEL_FAST=openai/gpt-oss-20b
MODEL_STRONG=openai/gpt-oss-120b
LLM_REASONING_EFFORT=low
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=3
LLM_MAX_CONCURRENCY=2
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_S=3600

# Per-request budgets and loop limits
BUDGET_MAX_TOTAL_TOKENS=24000
BUDGET_MAX_COST_USD=0.05
MAX_STEPS=6
TOOL_TIMEOUT_S=30
ANSWER_MAX_TOKENS=900
ROUTER_MAX_TOKENS=200
RATE_LIMIT_RPM=20
RATE_LIMIT_BURST=5

# Retrieval (CPU only). EMBEDDING_PROVIDER=hash is a lexical stand-in for sandboxes without model downloads.
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RERANK_ENABLED=true
FASTEMBED_CACHE_PATH=.fastembed_cache
RETRIEVAL_K_FTS=30
RETRIEVAL_K_VEC=30
RETRIEVAL_RRF_K=60
RETRIEVAL_RERANK_CANDIDATES=20
RETRIEVAL_DEFAULT_TOP_K=8
HNSW_EF_SEARCH=100

# Text-to-SQL guardrails
SQL_STATEMENT_TIMEOUT_MS=3000
SQL_MAX_ROWS=200
SQL_MAX_GENERATION_ATTEMPTS=2
SQL_GEN_TIER=fast

# MCP server identity (stdio transport, single user per process)
MCP_USER_EMAIL=carol@example.test

# Corpus generator
SEED=42
